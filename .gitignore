# Local .terraform directories
**/.terraform/*

# .tfstate files (including bootstrap local state)
*.tfstate
*.tfstate.*
bootstrap/*.tfstate
bootstrap/*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Sensitive variables
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
